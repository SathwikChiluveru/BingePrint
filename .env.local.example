# Supabase — get from https://supabase.com/dashboard/project/<your-project>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server-side only, NEVER expose to client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL — used for auth redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Random secret used to hash visitor IPs for invite-preview rate limiting (e.g. `openssl rand -hex 32`)
INVITE_PREVIEW_SALT=
